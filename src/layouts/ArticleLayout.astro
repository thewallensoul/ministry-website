---
const { title, section = 'case_for_christianity', scripturePopups = false, scriptureTranslation = 'ESV' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/images/logo_small_diagonal.png" />
    <title>{title} | Computing Christianity</title>
    <link rel="stylesheet" href="/assets/css/actual.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=info" />
    <script is:inline src="/assets/js/head-loader.js"></script>
  </head>
  <body data-scripture-translation={scriptureTranslation}>
    <header class="site-header">
      <my-brand-bar></my-brand-bar>
      <nav class="desktop-nav">
        <my-navbar section="main" class="primary"></my-navbar>
        <my-navbar section={section} class="secondary"></my-navbar>
      </nav>
      <button class="hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
        ☰
      </button>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
        <mobile-nav-menu></mobile-nav-menu>
      </nav>
    </header>
    <main class="main-screen">
      <details class="toc-panel" open>
        <summary>On this page</summary>
        <nav id="toc-sidebar" aria-label="On this page"></nav>
      </details>
      <div class="main-content">
        <article>
          <slot />
        </article>
      </div>
    </main>
    <script is:inline>
      const tocPanel = document.querySelector('.toc-panel');
      if (tocPanel && window.matchMedia('(max-width: 768px)').matches) {
        tocPanel.open = false;
      }
    </script>
    {scripturePopups && (
      <>
        <script is:inline src="https://www.blueletterbible.org/assets/scripts/blbToolTip/BLB_ScriptTagger-min.js" type="text/javascript"></script>
        <script is:inline>
          BLB.Tagger.Translation = document.body.dataset.scriptureTranslation || 'ESV';
          BLB.Tagger.HyperLinks = 'all';
          BLB.Tagger.HideTranslationAbbrev = false;
          BLB.Tagger.DarkTheme = true;
          BLB.Tagger.TargetNewWindow = true;
          BLB.Tagger.Style = 'par';
          BLB.Tagger.NoSearchTagNames = '';
          BLB.Tagger.NoSearchClassNames = 'noTag doNotTag';
        </script>
      </>
    )}
    <my-footer></my-footer>
  </body>
</html>
